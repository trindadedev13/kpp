// unfoutenely, to use extern,
// you need to know types.
// although language dgaf about types
extern work puts(pointer) -> int from "c"

struct person
do
    let name = null
    let age = null

    work init(self, name, age)
    do
        self.name = name
        self.age = age
    end
end


let eu = person::new("Aquiles", 15)
puts("oie".get_type())
